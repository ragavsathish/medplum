{
  "arch": "aarch64",
  "distro": "alpine",
  "env": {
    "MEDPLUM_GONDOLIN_IMAGE": "1"
  },
  "alpine": {
    "version": "3.23.5",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "rng-tools",
      "ca-certificates",
      "bash",
      "curl",
      "git",
      "nodejs",
      "npm",
      "docker",
      "docker-cli-compose",
      "e2fsprogs",
      "e2fsprogs-extra",
      "iproute2",
      "iptables"
    ],
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "rootfs": {
    "label": "gondolin-medplum-health",
    "sizeMb": 16384
  },
  "init": {
    "rootfsInitExtra": "./medplum-health-rootfs-init-extra.sh"
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  }
}
