{
  "name": "medplum-health-tracking",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:acceptance": "MEDPLUM_DOCKER_ACCEPTANCE=1 vitest run --config tests/acceptance/vitest.config.mts --maxWorkers=2 --maxConcurrency=2 tests/acceptance/accounts/accounts.docker.ac-001-006.api.test.ts tests/acceptance/accounts/accounts.docker.ac-007-012.api.test.ts",
    "test:acceptance:docker": "docker compose -f docker-compose.acceptance.yml up -d --wait --pull never && npm run test:acceptance",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@medplum/core": "5.1.37",
    "@medplum/fhirtypes": "5.1.37",
    "@types/express": "5.0.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "express": "5.2.1"
  }
}
